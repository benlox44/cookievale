# Database
DATABASE_URL=postgresql://user:password@db:5432/dbname
POSTGRES_USER=user
POSTGRES_PASSWORD=password
POSTGRES_DB=dbname

# App
DEBUG=True
SECRET_KEY=yoursecretkey
